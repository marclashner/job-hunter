# Application
APP_NAME=autonomous-job-search-agent
APP_ENV=development
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
# Docker Compose maps the database to host port 5433 to avoid colliding with a
# local Postgres instance on 5432.
DATABASE_URL=postgresql+psycopg://jobsearch:jobsearch@localhost:5433/jobsearch
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# OpenAI Agents SDK (JobEvaluationAgent). Never commit a real key.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EVALUATION_TEMPERATURE=0
OPENAI_EVALUATION_SEED=42
EVALUATION_BATCH_LIMIT_DEFAULT=50
EVALUATION_BATCH_LIMIT_MAX=200
EVALUATION_CONCURRENCY=2
EVALUATION_CONCURRENCY_MAX=8
EVALUATION_RATE_LIMIT_PER_MINUTE=30
# Optional USD estimates when the model reports token usage
# OPENAI_INPUT_USD_PER_MILLION=0.15
# OPENAI_OUTPUT_USD_PER_MILLION=0.60
